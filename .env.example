# Dirección de la API de la Unidad 2 a la que el servidor de Vite reenvía /api (npm run dev y npm run preview)
API_TARGET=http://localhost:3000

# Solo si la API se publica en un dominio distinto al de esta app. Si se deja vacío,
# la app llama a /api en su mismo dominio (recomendado: la cookie de sesión viaja sin CORS).
VITE_API_URL=
